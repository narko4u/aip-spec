{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aip.empirelabs.com.au/schemas/action-schema-v1.json",
  "title": "AIP Action Schema",
  "description": "Defines a single AIP Action: typed input/output contract for agent capability invocation.",
  "type": "object",
  "required": ["aip_version", "action_id", "version", "input_schema", "output_schema", "transport"],
  "properties": {
    "aip_version": { "type": "string", "description": "AIP protocol version (e.g. '0.1')" },
    "action_id": { "type": "string", "description": "Unique action identifier (e.g. 'policy.evaluate.v1')" },
    "version": { "type": "string", "description": "Schema version (e.g. '1.0.0')" },
    "display_name": { "type": "string" },
    "description": { "type": "string" },
    "input_schema": { "type": "object", "description": "JSON Schema describing valid inputs" },
    "output_schema": { "type": "object", "description": "JSON Schema describing valid outputs" },
    "transport": {
      "type": "object",
      "required": ["protocol", "endpoint"],
      "properties": {
        "protocol": { "type": "string", "enum": ["https", "mcp", "grpc", "websocket"] },
        "endpoint": { "type": "string", "format": "uri" },
        "method": { "type": "string" },
        "headers": { "type": "object" }
      }
    },
    "timeout_seconds": { "type": "integer", "minimum": 1 },
    "idempotent": { "type": "boolean" },
    "cost": {
      "type": "object",
      "properties": {
        "amount": { "type": "integer" },
        "currency": { "type": "string" },
        "per_invocation": { "type": "boolean" }
      }
    },
    "required_evidence": { "type": "array", "items": { "type": "string" } }
  }
}
